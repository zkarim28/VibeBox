# Copy this file to ".env" (same folder) and fill it in.
# start-party-games.sh and server.py both load it automatically. Not committed.

# ============================================================================
# TEXT the public link to your phone when a new tunnel opens.
# The text is sent as a tiny e-mail to T-Mobile's SMS gateway, so it needs an
# outgoing mail account. A free Gmail App Password is easiest:
#   Google Account > Security > 2-Step Verification > App passwords
#   (make one, it's 16 characters, use it below - NOT your Gmail password)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=zarifkarim28@gmail.com
SMTP_PASS=qbkrkozcstxxmbcr

# number + carrier gateway (these are the defaults - only change if wrong)
# NOTIFY_SMS=6313741134
# SMS_GATEWAY=tmomail.net        # T-Mobile.  Verizon: vzwpix.com   AT&T: txt.att.net

# want the full links e-mailed too? put an address here (off by default)
# NOTIFY_EMAIL=zarifkarim28@gmail.com

# Backup / alternative: free push notification via the ntfy.sh app. If T-Mobile
# ever filters the SMS, this always lands. Pick a hard-to-guess topic.
# NOTIFY_WEBHOOK=https://ntfy.sh/vibebox-9f3k2j-links

# ---- after editing, verify it works: ----
#   python3 notify.py --test

# ---- other optional settings ----
# HOST_PASSWORD=Brownnation1!    # lock-screen password (this is the default)
# ROOM_CODE=PLAY                 # keep the room code stable across restarts
