# Copy to .env. Never commit your real .env.
# Use the SAME topic URL on every computer to receive all startup links together.
NOTIFY_WEBHOOK=https://ntfy.sh/replace-with-a-long-random-topic
# Optional, for an account-protected ntfy topic:
# NOTIFY_TOKEN=tk_replace_me

# Use your own password so notification links can unlock the host-player page.
# HOST_PASSWORD=replace-with-your-own-password

# Optional: skip the Local/Public prompt. Public mode needs cloudflared.
# MODE=public
# For a named tunnel or existing public deployment:
# PUBLIC_URL=https://games.example.com

# Optional SMTP notifications (independent of ntfy).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# NOTIFY_EMAIL=you@example.com
# NOTIFY_SMS=your-phone-number
# SMS_GATEWAY=off
